{
  "name": "akfc_2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "clean": "rm -rf apps/web/.next apps/web/.next-e2e node_modules/.cache",
    "dev:clean": "pnpm clean && pnpm dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait --remove-orphans",
    "dev:infra:stop": "docker compose -f docker-compose.dev.yml stop",
    "db:migrate": "prisma migrate deploy",
    "db:seed:dev": "node --env-file=.env prisma/db-target.mjs && node --env-file=.env prisma/seed.sandbox.mjs",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter backend typecheck && tsc -p tsconfig.json",
    "lint": "pnpm --filter web lint && eslint --max-warnings 0 packages/backend/src packages/contracts/src packages/finder-core/src e2e playwright.config.ts",
    "postinstall": "pnpm prisma generate",
    "e2e": "node e2e/prepare.mjs && playwright test",
    "e2e:report": "playwright show-report",
    "docs:procedures": "node scripts/build-procedure-map.mjs --write",
    "check": "node scripts/check-next-conventions.mjs && node scripts/check-tour-targets.mjs && node scripts/build-procedure-map.mjs && node scripts/check-doc-entities.mjs && node scripts/check-doc-snippets.mjs && node scripts/check-doc-components.mjs && node scripts/check-doc-installs.mjs && pnpm clean && pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/pm": "3.27.3",
      "@tiptap/core": "3.27.3"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@playwright/test": "1.56.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.throttle": "^4.1.9",
    "@types/mailparser": "3.9.0",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
