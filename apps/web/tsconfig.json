{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": ["mdx"],
    "paths": {
      "@/*": ["./src/*"],  // indispensable pour shadcn/ui
      "@web/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@contracts/*": ["../../packages/contracts/src/*"],
      "@backend/*": ["../../packages/backend/src/*"],
      "@features/*": ["./src/features/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@styles/*": ["./src/styles/*"],
      "@types/*": ["./src/types/*"],
      "@trpc/*": ["./src/core/trpc/*"],
      "@config/*": ["../../packages/config/*"],
      "@finder-core/*": ["../../packages/finder-core/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/contracts/src/**/*.ts",
    "../../packages/config",
    "../../packages/finder-core/src/**/*.ts"
  ],
  "exclude": ["node_modules", ".next-e2e"]
}
