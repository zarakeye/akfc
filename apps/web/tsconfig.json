{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": ["mdx"],
    // Pas d'alias ici : « #… » (même paquet) et « @akfc/… » (autre paquet) viennent des
    // champs "imports" et "exports" des package.json, lus par TypeScript, Node et Next.
  },
  "include": [
    "next-env.d.ts",
    "src",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/contracts/src/**/*.ts",
    "../../packages/config",
    "../../packages/finder-core/src/**/*.ts"
  ],
  "exclude": ["node_modules", ".next-e2e"]
}
