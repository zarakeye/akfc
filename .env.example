# ════════════════════════════════════════════════════════════════════════
#  AKFC — MODÈLE de configuration d'environnement
#
#  Valeurs bidon : ce fichier documente les variables, pas leurs secrets.
#  Deux fichiers d'env sont versionnés : celui-ci (le modèle complet) et
#  .env.dev.example (les valeurs prêtes pour docker-compose.dev.yml).
#
#  En local  : voir .env.dev.example (copié en `.env` pour la CLI Prisma et
#              en `apps/web/.env.local` pour Next).
#  En prod   : le build est `output: "standalone"` et le Dockerfile ne copie
#              AUCUN .env. Les variables serveur sont injectées dans le
#              conteneur par le compose (`env_file:` de préférence).
#              Une `NEXT_PUBLIC_*` présente au BUILD est recopiée en dur dans
#              le code compilé (navigateur ET serveur) : elle se passe en
#              build arg, et la changer impose de reconstruire l'image.
# ════════════════════════════════════════════════════════════════════════

# ─── Base de données (Prisma) ───────────────────────────────────────────
# ⚠ En Docker, l'hôte n'est PAS localhost mais le nom du service compose
#   (ex. pgbouncer). Un `@localhost` ici casse la connexion dans le conteneur.
DATABASE_URL=postgresql://user:password@host:5432/akfc_db?schema=public
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/akfc_db?schema=public
PRISMA_CLIENT_ENGINE_TYPE=library

# ─── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-long-random-string

# ─── Cloudflare R2 (REQUIS : le client lève une erreur si une manque) ────
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
# Facultatives. Le stockage local (dev, sandbox) exige les adresses « path-style » :
# R2_FORCE_PATH_STYLE=true
# Adresse vue par le NAVIGATEUR pour les URL signées, si elle diffère de
# R2_ENDPOINT (sandbox : `storage:8333` n'existe que dans le réseau Docker).
# R2_PUBLIC_ENDPOINT=http://localhost:9000

# ─── Identité de l'app ───────────────────────────────────────────────────
APP_FULL_NAME=Association ...
# Racine du stockage : APP_SHORT_NAME (serveur, au démarrage) et
# NEXT_PUBLIC_APP_SHORT_NAME (figée au build) doivent avoir la MÊME valeur.
APP_SHORT_NAME=AKFC
NEXT_PUBLIC_APP_SHORT_NAME=AKFC
NEXTAUTH_URL=https://akfc.example.org
APP_SUPPORT_EMAIL=contact@example.org
# Facultative : adresse du site (SEO, liens des e-mails). Défaut : https://akfc.fr
# NEXT_PUBLIC_SITE_URL=https://akfc.example.org

# ─── SMTP (emails transactionnels) ───────────────────────────────────────
# OVH Zimbra : smtp.mail.ovh.net, port 465 (SSL/TLS) ou 587 (STARTTLS, exigé par le code).
# Hetzner bloque le 465 sortant par défaut : utiliser 587.
# SMTP_USER = adresse complète du compte d'envoi ; SMTP_FROM_NOREPLY = adresse complète affichée.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=noreply@example.org
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NOREPLY=noreply@example.org
# Réponses des membres aux e-mails automatiques (facultatif)
SMTP_REPLY_TO=contact@example.org

# ─── Demandes (tickets) : facultatif ─────────────────────────────────────
# Relève des réponses par IMAP : active seulement si TICKET_IMAP_HOST est défini.
# Identifiants : ceux du SMTP par défaut.
# TICKET_IMAP_HOST=imap.example.org
# TICKET_IMAP_PORT=993
# TICKET_IMAP_USER=noreply@example.org
# TICKET_IMAP_PASSWORD=your-imap-password
# TICKET_IMAP_INTERVAL_SEC=120
# TICKET_IMAP_FOLDER=INBOX
# TICKET_IMAP_DONE_FOLDER=Tickets traités
# TICKET_IMAP_REVIEW_FOLDER=Tickets à vérifier
# Copie cachée des réponses du site (défaut : SMTP_REPLY_TO)
# TICKET_ARCHIVE_BCC=archives@example.org
# Récapitulatif quotidien des demandes, à cette heure (Paris, défaut 8)
# TICKET_RECAP_HOUR=8
# TICKET_RECAP_DISABLED=1

# ─── Tâches planifiées : interrupteur ────────────────────────────────────
# Purge quotidienne des données arrivées à échéance (RGPD) : 1 pour la couper.
# RETENTION_PURGE_DISABLED=1
